# Copy to .env and adjust.
DATABASE_URL="postgresql://pharmahub:pharmahub@localhost:5432/pharmahub?schema=public"
# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Where uploaded prescriptions are stored (local disk adapter in lib/storage.ts).
# Keep this OUTSIDE public/. On serverless hosts (e.g. Vercel) local disk is
# ephemeral: implement the S3-style adapter instead.
STORAGE_DIR="./storage"
